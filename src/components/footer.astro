---
import { DEFAULT_LANG, isLang, localePath, getUi, type Lang } from '../i18n';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LANG;
const ui = getUi(lang);
---

<footer class='site-footer'>
  <div class='shell site-footer__inner'>
    <p class='mono'>{ui.footer.tagline}</p>
    <nav aria-label={ui.footer.nav}>
      <a href={localePath(lang, '/work')}>{ui.nav.work}</a>
      <a href={localePath(lang, '/projects')}>{ui.nav.projects}</a>
      <a href='https://github.com/gabo8191' target='_blank' rel='noopener noreferrer'>
        {ui.common.github}<span class='sr-only'>{ui.common.opensInNewTab}</span>
      </a>
      <a href='https://linkedin.com/in/gabodev8191' target='_blank' rel='noopener noreferrer'>
        {ui.common.linkedin}<span class='sr-only'>{ui.common.opensInNewTab}</span>
      </a>
      <a href='mailto:gabo8191@gmail.com'>{ui.common.email}</a>
    </nav>
  </div>
</footer>
