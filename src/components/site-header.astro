---
import { DEFAULT_LANG, LOCALES, isLang, localePath, stripLocale, getUi, type Lang } from '../i18n';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LANG;
const ui = getUi(lang);
const pagePath = stripLocale(Astro.url.pathname);
const links = [
  { href: '/work', label: ui.nav.work },
  { href: '/projects', label: ui.nav.projects },
  { href: '/about', label: ui.nav.about },
  { href: '/contact', label: ui.nav.contact },
];
const isCurrent = (href: string) => pagePath === href;

// The same page in the other locale, so switching language never loses your place.
const other = LOCALES.find((code) => code !== lang)!;
const switchHref = localePath(other, pagePath);
---

<header class='site-header'>
  <div class='shell site-header__inner'>
    <a class='brand' href={localePath(lang)}>
      <span class='brand__mark' aria-hidden='true'>GC</span>
      <span class='brand__name'>Gabriel Castillo</span>
    </a>

    <nav class='nav' aria-label={ui.nav.main}>
      {links.map((link) => (
        <a href={localePath(lang, link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a class='lang-switch' href={switchHref} lang={other} hreflang={other} aria-label={ui.nav.switchLabel}>
        {ui.nav.switchShort}
      </a>
    </nav>

    <details class='menu'>
      <summary>{ui.nav.menu}</summary>
      <nav class='menu__panel' aria-label={ui.nav.mobile}>
        <a href={localePath(lang)} aria-current={pagePath === '' ? 'page' : undefined}>{ui.nav.home}</a>
        {links.map((link) => (
          <a href={localePath(lang, link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a class='lang-switch' href={switchHref} lang={other} hreflang={other}>
          {ui.nav.switchLabel}
        </a>
      </nav>
    </details>
  </div>
</header>
