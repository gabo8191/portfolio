---
import Footer from '../components/footer.astro';
import SiteHeader from '../components/site-header.astro';
import RootLayout from './RootLayout.astro';

const { title, description } = Astro.props;
---

<!-- Interior pages: each one renders its own PageHead in the "head" slot and
     its content in the default slot, inside the shared page body. -->
<RootLayout title={title} description={description}>
  <div class='frame'>
    <SiteHeader />
    <main id='main-content'>
      <slot name='head' />
      <div class='shell page-body'>
        <slot />
      </div>
    </main>
    <Footer />
  </div>
</RootLayout>
