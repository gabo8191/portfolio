---
import LoadingIndicator from 'astro-loading-indicator/component';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const { title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const defaultTitle =
  'Gabriel Castillo | Backend Developer & Co-founder of Vulcano';
const defaultDescription =
  'Gabriel Castillo is a Backend Developer from Tunja, Colombia, and co-founder of Vulcano, a software, data and automation engineering studio. 3+ years building scalable REST APIs, microservices and containerized applications with Laravel, NestJS and Python, plus Docker, AWS, CI/CD pipelines and Linux server administration.';

const pageTitle = title ?? defaultTitle;
const pageDescription = description ?? defaultDescription;
const siteUrl = Astro.site ?? Astro.url;
// Normaliza con barra final para que canonical = og:url = sitemap (GitHub Pages
// sirve las rutas con barra). Evita señales de canonicalización contradictorias.
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, siteUrl).href;
// Las redes exigen URL absoluta para la imagen OG (no sirve la ruta relativa).
const ogImage = new URL(image ?? `${base}og-image.png`, siteUrl).href;

// Mismo @id que publica vulcanoservices.dev en su Organization. Al coincidir el
// identificador, buscadores y motores de respuesta con IA reconcilian ambas
// entidades en una sola: "Gabriel Castillo, cofundador de Vulcano".
const vulcanoId = 'https://vulcanoservices.dev/#organization';

const vulcanoLd = {
  '@type': 'Organization',
  '@id': vulcanoId,
  name: 'Vulcano',
  url: 'https://vulcanoservices.dev',
  logo: 'https://vulcanoservices.dev/brand/logo-192.png',
  description:
    'Software, data and process-automation engineering studio. Custom software, data engineering, BI, RPA and systems integration.',
  sameAs: ['https://www.linkedin.com/company/vulcanoia'],
};

const personLd = {
  '@type': 'Person',
  '@id': `${new URL(base, siteUrl).href}#gabriel-castillo`,
  name: 'Gabriel Castillo',
  alternateName: 'gabo8191',
  url: new URL(base, siteUrl).href,
  jobTitle: ['Backend Developer', 'Co-founder at Vulcano'],
  description: defaultDescription,
  image: ogImage,
  email: 'mailto:gabo8191@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tunja',
    addressRegion: 'Boyacá',
    addressCountry: 'Colombia',
  },
  nationality: { '@type': 'Country', name: 'Colombia' },
  knowsLanguage: ['es', 'en'],
  // Doble arista hacia Vulcano: fundador y responsable técnico
  worksFor: { '@id': vulcanoId },
  affiliation: { '@id': vulcanoId },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Universidad Pedagógica y Tecnológica de Colombia (UPTC)',
  },
  colleague: {
    '@type': 'Person',
    name: 'Diana Pinzón',
    url: 'https://portfoliodiana.netlify.app',
  },
  sameAs: [
    'https://github.com/gabo8191',
    'https://linkedin.com/in/gabodev8191',
    'https://twitter.com/gcastillo8191',
    'https://vulcanoservices.dev',
  ],
  knowsAbout: [
    'Backend development',
    'Laravel',
    'NestJS',
    'Python',
    'REST API design',
    'Microservices',
    'Docker',
    'Kubernetes',
    'AWS',
    'PostgreSQL',
    'MySQL',
    'Data engineering',
    'ETL pipelines',
    'CI/CD',
    'Linux server administration',
  ],
  seeks: {
    '@type': 'Demand',
    name: 'Remote backend engineering roles and freelance projects',
  },
  // Canal de contacto explícito: describir quién eres no basta para que te
  // escriban, hay que declarar por dónde y en qué idiomas.
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'hiring',
      email: 'gabo8191@gmail.com',
      url: new URL(`${base}contact/`, siteUrl).href,
      availableLanguage: ['Spanish', 'English'],
      areaServed: 'Worldwide (remote)',
    },
  ],
  potentialAction: {
    '@type': 'CommunicateAction',
    name: 'Contact Gabriel Castillo',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL(`${base}contact/`, siteUrl).href,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
  },
};

// Grafo de entidades: Person ← ProfilePage, enlazado a la Organization.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    vulcanoLd,
    personLd,
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en-US',
      mainEntity: { '@id': personLd['@id'] },
      about: { '@id': personLd['@id'] },
      primaryImageOfPage: ogImage,
    },
  ],
};
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='theme-color' content='#0f0a1a' />
    <link rel='icon' type='image/svg+xml' href={`${base}favicon.svg`} />
    <link rel='canonical' href={canonical} />
    <meta name='generator' content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name='description' content={pageDescription} />

    <meta property='og:url' content={canonical} />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='Gabriel Castillo' />
    <meta property='og:locale' content='en_US' />
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={pageDescription} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content='Gabriel Castillo — Backend Developer' />

    <!-- Twitter Meta Tags -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@gcastillo8191' />
    <meta name='twitter:creator' content='@gcastillo8191' />
    <meta property='twitter:domain' content='gabo8191.github.io' />
    <meta property='twitter:url' content={canonical} />
    <meta name='twitter:title' content={pageTitle} />
    <meta name='twitter:description' content={pageDescription} />
    <meta name='twitter:image' content={ogImage} />
    <meta name='twitter:image:alt' content='Gabriel Castillo — Backend Developer' />

    <script
      type='application/ld+json'
      set:html={JSON.stringify(jsonLd)}
    />

    <Font cssVariable='--font-geist' preload />
    <ClientRouter />
    <LoadingIndicator color='#f4f4f5' height='2px' />
  </head>
  <body class='font-sans min-h-screen bg-zinc-900'>
    <a
      href='#main-content'
      class='sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-zinc-100 focus:text-zinc-900'
      >Skip to main content</a
    >
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
