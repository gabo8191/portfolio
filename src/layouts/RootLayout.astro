---
import LoadingIndicator from 'astro-loading-indicator/component';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import {
  DEFAULT_LANG,
  HTML_LANG,
  LOCALES,
  OG_LOCALE,
  isLang,
  localePath,
  stripLocale,
  getUi,
  type Lang,
} from '../i18n';

const { title, description, image } = Astro.props;
const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LANG;
const ui = getUi(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const defaultTitle = ui.meta.defaultTitle;
const defaultDescription = ui.meta.defaultDescription;

const pageTitle = title ?? defaultTitle;
const pageDescription = description ?? defaultDescription;
const siteUrl = Astro.site ?? Astro.url;
// Keep canonical, og:url, and sitemap paths consistent with GitHub Pages.
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, siteUrl).href;
// Social previews require an absolute Open Graph image URL.
const ogImage = new URL(image ?? `${base}og-image.png`, siteUrl).href;

// Every page exists in each locale: declare the alternates so search engines serve
// the right language, plus x-default pointing at the English original.
const pagePath = stripLocale(pathname);
const alternates = LOCALES.map((code) => ({
  code,
  hreflang: HTML_LANG[code],
  href: new URL(localePath(code, pagePath), siteUrl).href,
}));
const xDefault = alternates.find((alternate) => alternate.code === DEFAULT_LANG)!.href;
const homeUrl = new URL(localePath(lang), siteUrl).href;
const inLanguage = HTML_LANG[lang];

// Breadcrumbs for interior pages (the home page has none).
const breadcrumbLd =
  pagePath === ''
    ? null
    : {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: ui.meta.breadcrumbHome, item: homeUrl },
          { '@type': 'ListItem', position: 2, name: pageTitle, item: canonical },
        ],
      };

// Use the employer's public organization identity in structured data.
const keyrusId = 'https://www.keyrus.com/#organization';

const keyrusLd = {
  '@type': 'Organization',
  '@id': keyrusId,
  name: 'Keyrus Colombia S.A.S.',
  url: 'https://www.keyrus.com/co/es',
  description: ui.meta.keyrusDescription,
  sameAs: ['https://www.linkedin.com/company/keyrus'],
};

const personLd = {
  '@type': 'Person',
  '@id': `${new URL(base, siteUrl).href}#gabriel-castillo`,
  name: 'Gabriel Castillo',
  alternateName: 'gabo8191',
  url: homeUrl,
  jobTitle: ui.meta.jobTitles,
  description: defaultDescription,
  image: new URL(`${base}avatar.png`, siteUrl).href,
  email: 'mailto:gabo8191@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tunja',
    addressRegion: 'Boyacá',
    addressCountry: 'Colombia',
  },
  nationality: { '@type': 'Country', name: 'Colombia' },
  knowsLanguage: ['es', 'en'],
  worksFor: { '@id': keyrusId },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Universidad Pedagógica y Tecnológica de Colombia (UPTC)',
  },
  sameAs: [
    'https://github.com/gabo8191',
    'https://linkedin.com/in/gabodev8191',
    'https://twitter.com/gcastillo8191',
  ],
  knowsAbout: [
    'Backend development',
    'System integration',
    'Production support',
    'Internal tools',
    'Business intelligence',
    'SQL',
    'pandas',
    'Laravel',
    'NestJS',
    'Python',
    'REST API design',
    'Docker',
    'PostgreSQL',
    'MySQL',
    'CI/CD',
  ],
  // Keep a public contact method without advertising a job search.
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: ui.meta.contactType,
      email: 'gabo8191@gmail.com',
      url: new URL(localePath(lang, '/contact'), siteUrl).href,
      availableLanguage: ['Spanish', 'English'],
      areaServed: ui.meta.areaServed,
    },
  ],
  potentialAction: {
    '@type': 'CommunicateAction',
    name: ui.meta.contactAction,
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL(localePath(lang, '/contact'), siteUrl).href,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
  },
};

// Person and ProfilePage linked to the current employer.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    keyrusLd,
    personLd,
    ...(breadcrumbLd ? [breadcrumbLd] : []),
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage,
      mainEntity: { '@id': personLd['@id'] },
      about: { '@id': personLd['@id'] },
      primaryImageOfPage: ogImage,
    },
  ],
};
---

<!doctype html>
<html lang={inLanguage}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='theme-color' content='#ffd93d' />
    <link rel='icon' type='image/svg+xml' href={`${base}favicon.svg`} />
    <link rel='canonical' href={canonical} />
    {alternates.map((alternate) => (
      <link rel='alternate' hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel='alternate' hreflang='x-default' href={xDefault} />
    <meta name='generator' content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name='description' content={pageDescription} />
    <meta name='author' content='Gabriel Castillo' />
    <meta
      name='robots'
      content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
    />

    <meta property='og:url' content={canonical} />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={ui.meta.siteName} />
    <meta property='og:locale' content={OG_LOCALE[lang]} />
    {LOCALES.filter((code) => code !== lang).map((code) => (
      <meta property='og:locale:alternate' content={OG_LOCALE[code]} />
    ))}
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={pageDescription} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={ui.meta.ogImageAlt} />

    <!-- Twitter Meta Tags -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@gcastillo8191' />
    <meta name='twitter:creator' content='@gcastillo8191' />
    <meta property='twitter:domain' content={new URL(siteUrl).hostname} />
    <meta property='twitter:url' content={canonical} />
    <meta name='twitter:title' content={pageTitle} />
    <meta name='twitter:description' content={pageDescription} />
    <meta name='twitter:image' content={ogImage} />
    <meta name='twitter:image:alt' content={ui.meta.ogImageAlt} />

    <script
      type='application/ld+json'
      set:html={JSON.stringify(jsonLd)}
    />

    <Font cssVariable='--font-archivo-black' preload />
    <Font cssVariable='--font-space-grotesk' preload />
    <Font cssVariable='--font-jetbrains-mono' />
    <ClientRouter />
    <LoadingIndicator color='#ff6fb5' height='4px' />
  </head>
  <body>
    <a href='#main-content' class='skip-link'>{ui.common.skipLink}</a>
    <slot />
    <script src='../scripts/reveal.ts'></script>
  </body>
</html>
