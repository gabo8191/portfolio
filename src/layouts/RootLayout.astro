---
import LoadingIndicator from 'astro-loading-indicator/component';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const { title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const defaultTitle =
  'Gabriel Castillo | Backend & Integration Engineer';
const defaultDescription =
  'Gabriel Castillo builds backend systems, integrations and internal tools and investigates production incidents. Experience with Python/Django, NestJS, Laravel, Java and SQL.';

const pageTitle = title ?? defaultTitle;
const pageDescription = description ?? defaultDescription;
const siteUrl = Astro.site ?? Astro.url;
// Keep canonical, og:url, and sitemap paths consistent with GitHub Pages.
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, siteUrl).href;
// Social previews require an absolute Open Graph image URL.
const ogImage = new URL(image ?? `${base}og-image.png`, siteUrl).href;

// Use the employer's public organization identity in structured data.
const keyrusId = 'https://www.keyrus.com/#organization';

const keyrusLd = {
  '@type': 'Organization',
  '@id': keyrusId,
  name: 'Keyrus Colombia S.A.S.',
  url: 'https://www.keyrus.com/co/es',
  description:
    'International data intelligence and digital transformation consultancy, operating in Data & Analytics, Cloud, Digital Transformation and Digital Commerce.',
  sameAs: ['https://www.linkedin.com/company/keyrus'],
};

const personLd = {
  '@type': 'Person',
  '@id': `${new URL(base, siteUrl).href}#gabriel-castillo`,
  name: 'Gabriel Castillo',
  alternateName: 'gabo8191',
  url: new URL(base, siteUrl).href,
  jobTitle: [
    'Backend Developer',
    'BI & Data Analytics Intern at Keyrus',
  ],
  description: defaultDescription,
  image: new URL(`${base}avatar.png`, siteUrl).href,
  email: 'mailto:gabo8191@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tunja',
    addressRegion: 'Boyacá',
    addressCountry: 'Colombia',
  },
  nationality: { '@type': 'Country', name: 'Colombia' },
  knowsLanguage: ['es', 'en'],
  worksFor: { '@id': keyrusId },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Universidad Pedagógica y Tecnológica de Colombia (UPTC)',
  },
  sameAs: [
    'https://github.com/gabo8191',
    'https://linkedin.com/in/gabodev8191',
    'https://twitter.com/gcastillo8191',
  ],
  knowsAbout: [
    'Backend development',
    'System integration',
    'Production support',
    'Internal tools',
    'Business intelligence',
    'SQL',
    'pandas',
    'Laravel',
    'NestJS',
    'Python',
    'REST API design',
    'Docker',
    'PostgreSQL',
    'MySQL',
    'CI/CD',
  ],
  // Keep a public contact method without advertising a job search.
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'professional inquiries',
      email: 'gabo8191@gmail.com',
      url: new URL(`${base}contact/`, siteUrl).href,
      availableLanguage: ['Spanish', 'English'],
      areaServed: 'Worldwide (remote)',
    },
  ],
  potentialAction: {
    '@type': 'CommunicateAction',
    name: 'Contact Gabriel Castillo',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL(`${base}contact/`, siteUrl).href,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
  },
};

// Person and ProfilePage linked to the current employer.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    keyrusLd,
    personLd,
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en-US',
      mainEntity: { '@id': personLd['@id'] },
      about: { '@id': personLd['@id'] },
      primaryImageOfPage: ogImage,
    },
  ],
};
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='theme-color' content='#111216' />
    <link rel='icon' type='image/svg+xml' href={`${base}favicon.svg`} />
    <link rel='canonical' href={canonical} />
    <meta name='generator' content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name='description' content={pageDescription} />

    <meta property='og:url' content={canonical} />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='Gabriel Castillo' />
    <meta property='og:locale' content='en_US' />
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={pageDescription} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content='Gabriel Castillo, backend and integration developer' />

    <!-- Twitter Meta Tags -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@gcastillo8191' />
    <meta name='twitter:creator' content='@gcastillo8191' />
    <meta property='twitter:domain' content='gabo8191.github.io' />
    <meta property='twitter:url' content={canonical} />
    <meta name='twitter:title' content={pageTitle} />
    <meta name='twitter:description' content={pageDescription} />
    <meta name='twitter:image' content={ogImage} />
    <meta name='twitter:image:alt' content='Gabriel Castillo, backend and integration developer' />

    <script
      type='application/ld+json'
      set:html={JSON.stringify(jsonLd)}
    />

    <Font cssVariable='--font-geist' preload />
    <ClientRouter />
    <LoadingIndicator color='#f4f4f5' height='2px' />
  </head>
  <body class='font-sans min-h-screen'>
    <a
      href='#main-content'
      class='sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-zinc-100 focus:text-zinc-900'
      >Skip to main content</a
    >
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
