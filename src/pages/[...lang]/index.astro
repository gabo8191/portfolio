---
import Footer from '../../components/footer.astro';
import Marquee from '../../components/marquee.astro';
import RiseText from '../../components/rise-text.astro';
import SiteHeader from '../../components/site-header.astro';
import StickerDesk from '../../components/sticker-desk.astro';
import RootLayout from '../../layouts/RootLayout.astro';
import { getProfessionalProjects, getProjects } from '../../i18n/data';
import { DEFAULT_LANG, getUi, isLang, localePath, localeStaticPaths, type Lang } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LANG;
const ui = getUi(lang);
const { home } = ui;
const PROFESSIONAL_PROJECTS = getProfessionalProjects(lang);
const PROJECTS = getProjects(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

// Lookups use the English keys; the displayed text comes back localized.
const selectedTitles = [
  'Internal Effort Estimation Tool',
  'SWIFT MT Support for an Interbank Gateway',
  'Electronic Billing Middleware',
];
const selectedWork = selectedTitles.map((key) => {
  const project = PROFESSIONAL_PROJECTS.find((item) => item.key === key);
  if (!project) throw new Error(`Missing selected professional project: ${key}`);
  return project;
});
const publicProjects = ['polyglot-microservices', 'tomoreader'].map((slug) => {
  const project = PROJECTS.find((item) => item.slug === slug);
  if (!project) throw new Error(`Missing public project: ${slug}`);
  return project;
});

const stack = [
  'PostgreSQL',
  'MySQL',
  'Oracle PL/SQL',
  'Redis',
  'Celery',
  'DRF',
  'Filament',
  'OpenAPI',
  'Docker',
  'Sentry',
  'GitHub Actions',
  'Power BI',
  'Tableau',
];
---

<RootLayout title={home.title} description={home.description}>
  <div class='frame'>
    <SiteHeader />
    <main id='main-content'>
      <Marquee items={home.focus} label={home.focusLabel} />

      <section class='hero' aria-labelledby='home-title'>
        <div class='shell hero__inner'>
          <div class='hero__kicker'>
            <span class='tag tag--ink'>{home.roleTag}</span>
            <span class='tag'>{home.locationTag}</span>
          </div>

          <h1 id='home-title' class='hero__name' aria-label='Gabriel Castillo'>
            <span class='hero__line'><RiseText text='Gabriel' /></span>
            <span class='hero__line hero__line--offset'><RiseText text='Castillo.' start={7} /></span>
          </h1>

          <div class='hero__bottom'>
            <div>
              <p class='hero__pitch'>
                {home.pitch}
              </p>
              <div class='hero__actions'>
                <a class='btn btn--ink' href={localePath(lang, '/work')}>{home.seeWork}</a>
                <a class='btn' href={`${base}/${home.cvFile}`} target='_blank' rel='noopener noreferrer'>
                  {home.downloadCv}<span class='sr-only'>{ui.common.opensInNewTab}</span>
                </a>
              </div>
            </div>
            <StickerDesk />
          </div>
        </div>
      </section>

      <section class='section' aria-labelledby='caps-title'>
        <div class='shell'>
          <div class='section-bar'>
            <div>
              <p class='section-bar__index mono'>{home.capsIndex}</p>
              <h2 id='caps-title' data-split>{home.capsTitle}</h2>
            </div>
          </div>
          <ul class='caps'>
            {home.capabilities.map((capability, index) => (
              <li class='cap block' data-stamp>
                <span class='mono'>0{index + 1}</span>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class='section section--ink' aria-labelledby='work-title'>
        <div class='shell'>
          <div class='section-bar'>
            <div>
              <p class='section-bar__index mono'>{home.workIndex}</p>
              <h2 id='work-title' data-split>{home.workTitle}</h2>
            </div>
            <a class='link' href={localePath(lang, '/work')}>{home.allWork}</a>
          </div>
          <div class='rows'>
            {selectedWork.map((project) => (
              <article class='row block' data-stamp>
                <div class='row__meta'>
                  <span class='tag tag--yellow'>{project.company}</span>
                  {project.period && <span class='tag'>{project.period}</span>}
                </div>
                <div>
                  <h3>{project.title}</h3>
                  <p class='measure'>{project.description}</p>
                  <ul class='tags tags--spaced' aria-label={home.technologies}>
                    {project.technologies.map((technology) => <li class='tag tag--pink'>{technology}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Marquee items={stack} reverse label={home.stackLabel} />

      <section class='section' aria-labelledby='open-title'>
        <div class='shell'>
          <div class='section-bar'>
            <div>
              <p class='section-bar__index mono'>{home.openIndex}</p>
              <h2 id='open-title' data-split>{home.openTitle}</h2>
            </div>
            <a class='link' href={localePath(lang, '/projects')}>{home.exploreProjects}</a>
          </div>
          <p class='measure lede'>
            {home.openLede}
          </p>
          <div class='oss'>
            {publicProjects.map((project, index) => (
              <article class:list={['block', index === 0 ? 'cap--yellow' : 'cap--pink']} data-stamp>
                <span class='tag tag--ink'>
                  {project.area === 'backend' ? home.areaBackend : home.areaDesktop}
                </span>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul class='tags' aria-label={home.technologies}>
                  {project.technologies.slice(0, 4).map((technology) => <li class='tag'>{technology}</li>)}
                </ul>
                {project.githubUrl && (
                  <a class='btn' href={project.githubUrl} target='_blank' rel='noopener noreferrer'>
                    {home.viewRepo}<span class='sr-only'>{ui.common.opensInNewTab}</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class='section section--pink' aria-labelledby='close-title'>
        <div class='shell closer'>
          <h2 id='close-title'>{home.closeTitleA}<span>{home.closeTitleB}</span></h2>
          <div>
            <p>
              {home.closeBody}
            </p>
            <div class='hero__actions'>
              <a class='btn btn--ink' href='mailto:gabo8191@gmail.com'>gabo8191@gmail.com</a>
              <a class='btn btn--yellow' href={localePath(lang, '/contact')}>{home.contactPage}</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</RootLayout>
