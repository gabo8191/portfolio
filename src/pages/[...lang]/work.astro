---
import PageHead from '../../components/page-head.astro';
import InfoLayout from '../../layouts/InfoLayout.astro';
import { getEmployers, getProfessionalProjects } from '../../i18n/data';
import { DEFAULT_LANG, getUi, isLang, localePath, localeStaticPaths, type Lang } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LANG;
const ui = getUi(lang);
const EMPLOYERS = getEmployers(lang);
const PROFESSIONAL_PROJECTS = getProfessionalProjects(lang);

// Group projects by employer in the established chronological order.
const byEmployer = EMPLOYERS.map((employer) => ({
  employer,
  id: `employer-${employer.name.toLowerCase().replaceAll(' ', '-')}`,
  projects: PROFESSIONAL_PROJECTS.filter((project) => project.company === employer.name),
}));
---

<InfoLayout title={ui.work.title} description={ui.work.description}>
  <PageHead slot='head' index={ui.work.index} title={ui.work.heading}>
    <p>{ui.work.intro(PROFESSIONAL_PROJECTS.length)}</p>
  </PageHead>

  {
    byEmployer.map(({ employer, id, projects }) => (
      <section class='employer' aria-labelledby={id}>
        <div class='employer__head'>
          <div>
            <h2 id={id}>{employer.name}</h2>
            <p>{employer.role}</p>
          </div>
          <span class='tag tag--yellow'>{employer.period}</span>
        </div>
        <p class='measure'>{employer.focus}</p>
        <div class='grid-2'>
          {projects.map((project) => (
            <article class='card block' data-stamp>
              <h3>{project.title}</h3>
              {project.period && <span class='tag'>{project.period}</span>}
              <p class='muted'>{project.description}</p>
              <ul class='tags' aria-label={ui.home.technologies}>
                {project.technologies.map((tech) => <li class='tag tag--pink'>{tech}</li>)}
              </ul>
              {project.liveUrl ? (
                <a class='link' href={project.liveUrl} target='_blank' rel='noopener noreferrer'>
                  {ui.work.viewLive}<span class='sr-only'>{ui.common.opensInNewTab}</span>
                </a>
              ) : (
                <span class='mono muted'>{ui.work.confidential}</span>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <aside class='block closer-block' data-stamp>
    <div>
      <h2 class='h2'>{ui.work.lookingTitle}</h2>
      <p class='measure'>{ui.work.lookingBody}</p>
    </div>
    <a class='btn btn--ink' href={localePath(lang, '/projects')}>{ui.work.seePersonal}</a>
  </aside>
</InfoLayout>
