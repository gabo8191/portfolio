---
import H1 from '../components/h1.astro';
import InfoLayout from '../layouts/InfoLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const experience = [
  {
    title: 'BI & Data Analytics Intern',
    company: 'Keyrus Colombia S.A.S.',
    period: 'Jul. 2026 – Present',
    highlights: [
      'Designed and built an internal Django application that analyzes PBIX files and estimates Power BI to Tableau migration effort. The team uses its estimates; formal deployment is pending.',
      'Built DRF APIs, Celery/Redis jobs, PostgreSQL persistence, Excel reporting and automated quality checks in GitHub Actions.',
      'Prepare and validate analytics data with SQL and Python for dashboard and migration work.',
    ],
  },
  {
    title: 'Freelance Fullstack Developer',
    company: 'TotalDev SAS',
    period: 'Feb. 2025 – Mar. 2026',
    highlights: [
      'Worked on MT message reception and created JSON mapping files for MT to MX and MX to MT conversion in a Java/Apache Camel interbank gateway.',
      'Built inventory APIs, CSV imports with row-level validation, regional reports and SQL views; worked on stock, production and monthly reporting workflows.',
      'Built one-use QR guest validation and Laravel/Filament content panels; contributed to field operations and inspection systems.',
      'This freelance engagement overlapped with PARQ from February to July 2025.',
    ],
  },
  {
    title: 'Fullstack Developer',
    company: 'PARQ',
    period: 'Nov. 2024 – Jul. 2025',
    highlights: [
      'Maintained NestJS services sharing a PostgreSQL database; investigated production data inconsistencies through SQL and code review.',
      'Implemented electronic invoicing connectors for SATCOM, Siigo and Alegra with transaction tracing and provider error handling.',
      'Worked on queued bulk loads, timezone-aware scheduled jobs, OpenAPI documentation and Docker/Portainer deployments.',
    ],
  },
  {
    title: 'Backend Developer',
    company: 'SEREMPRE',
    period: 'Jan. 2023 – Nov. 2024',
    highlights: [
      'Joined the Membeers backend team as a SENA intern, then continued as a Laravel developer for regional benefits and insurance systems.',
      'Handled L2/L3 production incidents with SQL, code review and Sentry; joined incident war rooms and documented root causes.',
      'Built APIs, SQL reports and procedures, queued jobs and scheduled processes; worked with Docker/DDEV, Cloudinary and Moodle LTI.',
    ],
  },
];

const skills = {
  languages: ['Python', 'TypeScript', 'PHP', 'SQL', 'Bash'],
  data: [
    'Tableau',
    'Power BI',
    'Analytical SQL',
    'pandas',
    'Power Query',
    'Tableau Prep',
    'Data Modelling',
  ],
  backend: [
    'Laravel',
    'NestJS',
    'Node.js',
    'REST API Design',
    'System Integration',
  ],
  databases: [
    'PostgreSQL',
    'MySQL',
    'Redis',
    'TypeORM',
    'Eloquent ORM',
    'Query Optimization',
  ],
  devops: [
    'Docker',
    'Production Support',
    'Linux',
    'CI/CD',
    'GitHub Actions',
    'Nginx',
  ],
  tools: ['Git', 'Swagger/OpenAPI', 'SonarQube', 'Portainer', 'Bitbucket'],
};
---

<InfoLayout
  title='About — Gabriel Castillo, Backend & Integration Engineer'
  description='Gabriel Castillo builds backend systems, integrations and internal tools, and investigates production incidents using SQL, code and application traces.'
>
  <!-- Hallmark · genre: modern-minimal · macrostructure: long-document · design-system: design.md · designed-as-app -->
  <div class='about-page flex flex-col gap-16'>
    <div class='space-y-4 sm:space-y-8'>
      <div class='flex flex-col sm:flex-row sm:items-center gap-5'>
        <img
          src={`${base}avatar.png`}
          alt='Pixel-art portrait of Gabriel Castillo'
          width='96'
          height='96'
          class='w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-2xl border border-zinc-700/60'
        />
        <H1> About Gabriel </H1>
      </div>

      <p class='text-xl xl:text-2xl text-zinc-400 text-balance max-w-3xl'>
        I build backend systems and integrations, especially when the difficult
        part is tracing what happened to a record, message or transaction. I
        follow it through SQL, logs and code, then turn the finding into a fix
        the team can maintain.
      </p>

      <p class='text-lg xl:text-xl text-zinc-400 text-balance max-w-3xl'>
        Over 3 years, I have built APIs and background jobs, handled L2/L3
        incidents, and connected financial messaging and electronic invoicing
        systems. At <span class='text-zinc-100'>Keyrus</span>, I designed a
        Django tool that analyzes PBIX files and produces migration estimates
        already used by the team. Its formal deployment is pending.
      </p>
    </div>

    <div class='space-y-4'>
      <h2
        class='text-2xl text-zinc-100'
      >
        Experience
      </h2>

      <div class='space-y-0 border-t border-zinc-700'>
        {
          experience.map((job) => (
            <article class='py-6 border-b border-zinc-700'>
              <div class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1'>
                <h3 class='text-lg text-zinc-200'>{job.title}</h3>
                <span class='text-sm text-zinc-400'>{job.period}</span>
              </div>
              <p class='text-zinc-400 text-sm mb-3'>{job.company}</p>
              <ul class='space-y-2'>
                {job.highlights.map((highlight) => (
                  <li class='text-zinc-400 text-sm pl-4 relative before:content-["•"] before:absolute before:left-0 before:text-zinc-500'>
                    {highlight}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>

    <div class='space-y-4'>
      <h2
        class='text-2xl text-zinc-100'
      >
        Technical Skills
      </h2>

      <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0 border-t border-zinc-700'>
        <div class='py-4 border-b border-zinc-700/70'>
          <h3 class='text-sm text-zinc-400 mb-2'>Languages</h3>
          <ul class='flex flex-wrap gap-2 list-none p-0 m-0'>
            {
              skills.languages.map((skill) => (
                <li class='px-2 py-1 text-xs text-zinc-300 bg-zinc-700/50 rounded'>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <div class='py-4 border-b border-zinc-700/70'>
          <h3 class='text-sm text-zinc-400 mb-2'>BI &amp; Data</h3>
          <ul class='flex flex-wrap gap-2 list-none p-0 m-0'>
            {
              skills.data.map((skill) => (
                <li class='px-2 py-1 text-xs text-zinc-300 bg-zinc-700/50 rounded'>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <div class='py-4 border-b border-zinc-700/70'>
          <h3 class='text-sm text-zinc-400 mb-2'>Backend</h3>
          <ul class='flex flex-wrap gap-2 list-none p-0 m-0'>
            {
              skills.backend.map((skill) => (
                <li class='px-2 py-1 text-xs text-zinc-300 bg-zinc-700/50 rounded'>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <div class='py-4 border-b border-zinc-700/70'>
          <h3 class='text-sm text-zinc-400 mb-2'>Databases</h3>
          <ul class='flex flex-wrap gap-2 list-none p-0 m-0'>
            {
              skills.databases.map((skill) => (
                <li class='px-2 py-1 text-xs text-zinc-300 bg-zinc-700/50 rounded'>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <div class='py-4 border-b border-zinc-700/70'>
          <h3 class='text-sm text-zinc-400 mb-2'>DevOps & Cloud</h3>
          <ul class='flex flex-wrap gap-2 list-none p-0 m-0'>
            {
              skills.devops.map((skill) => (
                <li class='px-2 py-1 text-xs text-zinc-300 bg-zinc-700/50 rounded'>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>

        <div class='py-4 border-b border-zinc-700/70'>
          <h3 class='text-sm text-zinc-400 mb-2'>Tools</h3>
          <ul class='flex flex-wrap gap-2 list-none p-0 m-0'>
            {
              skills.tools.map((skill) => (
                <li class='px-2 py-1 text-xs text-zinc-300 bg-zinc-700/50 rounded'>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class='space-y-4'>
      <h2
        class='text-2xl text-zinc-100'
      >
        Education
      </h2>

      <div class='space-y-4'>
        <div class='py-4 border-b border-zinc-700/70'>
          <div
            class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1'
          >
            <h3 class='text-lg text-zinc-200'>
              Systems and Computer Engineering
            </h3>
            <span class='text-sm text-zinc-400'>Expected 2026</span>
          </div>
          <p class='text-zinc-400 text-sm'>
            Pedagogical and Technological University of Colombia (UPTC)
          </p>
        </div>

        <div class='py-4 border-b border-zinc-700/70'>
          <div
            class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1'
          >
            <h3 class='text-lg text-zinc-200'>
              Information Systems Analysis and Development
            </h3>
            <span class='text-sm text-zinc-400'>2022</span>
          </div>
          <p class='text-zinc-400 text-sm'>National Learning Service (SENA)</p>
        </div>
      </div>
    </div>
  </div>
</InfoLayout>
