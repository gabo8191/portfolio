---
import PageHead from '../components/page-head.astro';
import InfoLayout from '../layouts/InfoLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const channels = [
  { label: 'Email', value: 'gabo8191@gmail.com', href: 'mailto:gabo8191@gmail.com', tone: 'cap--yellow', external: false },
  { label: 'LinkedIn', value: 'in/gabodev8191', href: 'https://linkedin.com/in/gabodev8191/', tone: 'cap--pink', external: true },
  { label: 'GitHub', value: 'gabo8191', href: 'https://github.com/gabo8191', tone: '', external: true },
  { label: 'X / Twitter', value: '@gcastillo8191', href: 'https://twitter.com/gcastillo8191', tone: '', external: true },
];
---

<InfoLayout
  title='Contact — Gabriel Castillo'
  description='Contact Gabriel Castillo about backend systems, integrations, internal tools and production support.'
>
  <PageHead slot='head' index='Contact' title="Let's connect" tone='blue'>
    <p>
      Backend systems, integrations or tools for complex data workflows? Write to me; I reply
      in Spanish or English.
    </p>
  </PageHead>

  <section aria-label='Contact channels'>
    <div class='contact-grid'>
      {channels.map((channel) => (
        <a
          class:list={['contact-card block', channel.tone]}
          href={channel.href}
          target={channel.external ? '_blank' : undefined}
          rel={channel.external ? 'noopener noreferrer' : undefined}
        >
          <span class='mono'>{channel.label}</span>
          <strong>{channel.value}</strong>
          {channel.external && <span class='sr-only'> (opens in new tab)</span>}
        </a>
      ))}
    </div>
  </section>

  <section class='about-section' aria-labelledby='cv-title'>
    <h2 id='cv-title' class='h2'>Download my CV</h2>
    <div class='hero__actions'>
      <a class='btn btn--ink' href={`${base}cv-en.pdf`} target='_blank' rel='noopener noreferrer'>
        English CV (PDF)<span class='sr-only'> (opens in new tab)</span>
      </a>
      <a class='btn btn--yellow' href={`${base}cv-es.pdf`} target='_blank' rel='noopener noreferrer'>
        CV en español (PDF)<span class='sr-only'> (opens in new tab)</span>
      </a>
    </div>
    <p class='mono muted about-note'>Tunja, Boyacá · Colombia · Remote</p>
  </section>
</InfoLayout>
