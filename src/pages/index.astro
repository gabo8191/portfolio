---
import Footer from '../components/footer.astro';
import Marquee from '../components/marquee.astro';
import RiseText from '../components/rise-text.astro';
import SiteHeader from '../components/site-header.astro';
import StickerDesk from '../components/sticker-desk.astro';
import RootLayout from '../layouts/RootLayout.astro';
import { PROFESSIONAL_PROJECTS } from '../data/professional';
import { PROJECTS } from '../data/projects';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const selectedTitles = [
  'Internal Effort Estimation Tool',
  'SWIFT MT Support for an Interbank Gateway',
  'Electronic Billing Middleware',
];
const selectedWork = selectedTitles.map((title) => {
  const project = PROFESSIONAL_PROJECTS.find((item) => item.title === title);
  if (!project) throw new Error(`Missing selected professional project: ${title}`);
  return project;
});
const publicProjects = ['polyglot-microservices', 'tomoreader'].map((slug) => {
  const project = PROJECTS.find((item) => item.slug === slug);
  if (!project) throw new Error(`Missing public project: ${slug}`);
  return project;
});

const focus = [
  'Backend',
  'Integrations',
  'Production support',
  'SQL',
  'Internal tools',
  'Python / Django',
  'NestJS',
  'Laravel',
  'Java / Apache Camel',
  'Remote from Tunja, CO',
];
const stack = [
  'PostgreSQL',
  'MySQL',
  'Oracle PL/SQL',
  'Redis',
  'Celery',
  'DRF',
  'Filament',
  'OpenAPI',
  'Docker',
  'Sentry',
  'GitHub Actions',
  'Power BI',
  'Tableau',
];
const capabilities = [
  {
    title: 'System integrations',
    body: 'Financial messaging (SWIFT MT and ISO 20022), electronic invoicing connectors and data workflows between systems that were never meant to talk.',
  },
  {
    title: 'Production support',
    body: 'L2/L3 incidents traced through SQL, logs and code until the failure is clear, then a fix the team can maintain and a written root cause.',
  },
  {
    title: 'Internal tools',
    body: 'Practical software teams use every day: estimation tools, inventory platforms, reports, queued exports and admin panels.',
  },
];
---

<RootLayout
  title='Gabriel Castillo | Backend & Integration Engineer'
  description='Backend developer in Colombia working on integrations, production support and internal tools with Python/Django, NestJS, Laravel and SQL.'
>
  <div class='frame'>
    <SiteHeader />
    <main id='main-content'>
      <Marquee items={focus} label='Areas of work' />

      <section class='hero' aria-labelledby='home-title'>
        <div class='shell hero__inner'>
          <div class='hero__kicker'>
            <span class='tag tag--ink'>Backend &amp; Integration Engineer</span>
            <span class='tag'>Tunja, Colombia · Remote</span>
          </div>

          <h1 id='home-title' class='hero__name' aria-label='Gabriel Castillo'>
            <span class='hero__line'><RiseText text='Gabriel' /></span>
            <span class='hero__line hero__line--offset'><RiseText text='Castillo.' start={7} /></span>
          </h1>

          <div class='hero__bottom'>
            <div>
              <p class='hero__pitch'>
                I connect systems, build internal tools and trace production incidents
                through code and data. Over three years with Python/Django, NestJS,
                Laravel, Java and SQL.
              </p>
              <div class='hero__actions'>
                <a class='btn btn--ink' href={`${base}/work/`}>See my work →</a>
                <a class='btn' href={`${base}/cv-en.pdf`} target='_blank' rel='noopener noreferrer'>
                  Download CV<span class='sr-only'> (opens in new tab)</span>
                </a>
              </div>
            </div>
            <StickerDesk />
          </div>
        </div>
      </section>

      <section class='section' aria-labelledby='caps-title'>
        <div class='shell'>
          <div class='section-bar'>
            <div>
              <p class='section-bar__index mono'>01 / What I do</p>
              <h2 id='caps-title' data-split>Where I'm useful</h2>
            </div>
          </div>
          <ul class='caps'>
            {capabilities.map((capability, index) => (
              <li class='cap block' data-stamp>
                <span class='mono'>0{index + 1}</span>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class='section section--ink' aria-labelledby='work-title'>
        <div class='shell'>
          <div class='section-bar'>
            <div>
              <p class='section-bar__index mono'>02 / Experience in practice</p>
              <h2 id='work-title' data-split>Selected work</h2>
            </div>
            <a class='link' href={`${base}/work/`}>All professional work →</a>
          </div>
          <div class='rows'>
            {selectedWork.map((project) => (
              <article class='row block' data-stamp>
                <div class='row__meta'>
                  <span class='tag tag--yellow'>{project.company}</span>
                  {project.period && <span class='tag'>{project.period}</span>}
                </div>
                <div>
                  <h3>{project.title}</h3>
                  <p class='measure'>{project.description}</p>
                  <ul class='tags tags--spaced' aria-label='Technologies'>
                    {project.technologies.map((technology) => <li class='tag tag--pink'>{technology}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Marquee items={stack} reverse label='Tools I use' />

      <section class='section' aria-labelledby='open-title'>
        <div class='shell'>
          <div class='section-bar'>
            <div>
              <p class='section-bar__index mono'>03 / Built in the open</p>
              <h2 id='open-title' data-split>Public projects</h2>
            </div>
            <a class='link' href={`${base}/projects/`}>Explore all projects →</a>
          </div>
          <p class='measure lede'>
            Most professional systems I work on are private. These personal projects show how
            I approach architecture and product decisions in public.
          </p>
          <div class='oss'>
            {publicProjects.map((project, index) => (
              <article class:list={['block', index === 0 ? 'cap--yellow' : 'cap--pink']} data-stamp>
                <span class='tag tag--ink'>
                  {project.area === 'backend' ? 'Backend & architecture' : 'Desktop application'}
                </span>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul class='tags' aria-label='Technologies'>
                  {project.technologies.slice(0, 4).map((technology) => <li class='tag'>{technology}</li>)}
                </ul>
                {project.githubUrl && (
                  <a class='btn' href={project.githubUrl} target='_blank' rel='noopener noreferrer'>
                    View repository<span class='sr-only'> (opens in new tab)</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class='section section--pink' aria-labelledby='close-title'>
        <div class='shell closer'>
          <h2 id='close-title'>Let's talk <span>systems.</span></h2>
          <div>
            <p>
              For backend work, an integration that keeps failing or a difficult production
              issue, write to me directly.
            </p>
            <div class='hero__actions'>
              <a class='btn btn--ink' href='mailto:gabo8191@gmail.com'>gabo8191@gmail.com</a>
              <a class='btn btn--yellow' href={`${base}/contact/`}>Contact page →</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</RootLayout>
