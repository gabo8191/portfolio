---
import PageHead from '../components/page-head.astro';
import InfoLayout from '../layouts/InfoLayout.astro';
import { EMPLOYERS, PROFESSIONAL_PROJECTS } from '../data/professional';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

// Group projects by employer in the established chronological order.
const byEmployer = EMPLOYERS.map((employer) => ({
  employer,
  id: `employer-${employer.name.toLowerCase().replaceAll(' ', '-')}`,
  projects: PROFESSIONAL_PROJECTS.filter((project) => project.company === employer.name),
}));
---

<InfoLayout
  title='Professional work — Gabriel Castillo'
  description='Professional work by Gabriel Castillo across Keyrus, TotalDev, PARQ and SEREMPRE: internal tools, interbank messaging, invoicing, inventory and production support.'
>
  <PageHead slot='head' index='Work' title='Professional work'>
    <p>
      {PROFESSIONAL_PROJECTS.length} projects across four employers since 2023. The
      descriptions explain my work without sharing private source code.
    </p>
  </PageHead>

  {
    byEmployer.map(({ employer, id, projects }) => (
      <section class='employer' aria-labelledby={id}>
        <div class='employer__head'>
          <div>
            <h2 id={id}>{employer.name}</h2>
            <p>{employer.role}</p>
          </div>
          <span class='tag tag--yellow'>{employer.period}</span>
        </div>
        <p class='measure'>{employer.focus}</p>
        <div class='grid-2'>
          {projects.map((project) => (
            <article class='card block' data-stamp>
              <h3>{project.title}</h3>
              {project.period && <span class='tag'>{project.period}</span>}
              <p class='muted'>{project.description}</p>
              <ul class='tags' aria-label='Technologies'>
                {project.technologies.map((tech) => <li class='tag tag--pink'>{tech}</li>)}
              </ul>
              {project.liveUrl ? (
                <a class='link' href={project.liveUrl} target='_blank' rel='noopener noreferrer'>
                  View live →<span class='sr-only'> (opens in new tab)</span>
                </a>
              ) : (
                <span class='mono muted'>Confidential source</span>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <aside class='block closer-block' data-stamp>
    <div>
      <h2 class='h2'>Looking for the code?</h2>
      <p class='measure'>
        Personal and open source projects are on their own page, with a timeline of what I
        built and when.
      </p>
    </div>
    <a class='btn btn--ink' href={`${base}/projects/`}>See personal projects →</a>
  </aside>
</InfoLayout>
