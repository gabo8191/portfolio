---
import H1 from '../components/h1.astro';
import InfoLayout from '../layouts/InfoLayout.astro';
import Link from '../components/link.astro';
import { EMPLOYERS, PROFESSIONAL_PROJECTS } from '../data/professional';

// Agrupa por empresa respetando el orden cronológico de EMPLOYERS.
const byEmployer = EMPLOYERS.map((employer) => ({
  employer,
  projects: PROFESSIONAL_PROJECTS.filter(
    (project) => project.company === employer.name,
  ),
}));
---

<InfoLayout
  title='Client work — Gabriel Castillo'
  description='Enterprise projects delivered by Gabriel Castillo at TotalDev, PARQ and Serempre: interbank messaging, electronic invoicing, inventory platforms, corporate benefits and event management systems.'
>
  <div class='p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh'>
    <H1>Client work</H1>
    <p class='mt-4 text-lg text-zinc-400 max-w-2xl text-balance'>
      {PROFESSIONAL_PROJECTS.length} systems delivered for companies across three
      roles between 2023 and 2026. The source code belongs to the clients, so what
      is documented here is the scope and the outcome.
    </p>

    <div class='mt-12 space-y-14'>
      {
        byEmployer.map(({ employer, projects }) => (
          <section aria-labelledby={`employer-${employer.name}`}>
            <div class='flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 pb-3 mb-6 border-b border-zinc-800'>
              <div>
                <h2
                  id={`employer-${employer.name}`}
                  class='text-xl text-zinc-100'
                >
                  {employer.name}
                </h2>
                <p class='text-sm text-zinc-500 mt-0.5'>{employer.role}</p>
              </div>
              <span class='text-sm text-zinc-400 tabular-nums'>
                {employer.period}
              </span>
            </div>

            <p class='text-sm text-zinc-400 max-w-2xl mb-6'>{employer.focus}</p>

            <div class='grid grid-cols-1 lg:grid-cols-2 gap-4'>
              {projects.map((project) => (
                <article class='p-5 rounded-xl bg-zinc-800/30 border border-zinc-700/30 hover:border-zinc-700/60 transition-colors'>
                  <h3 class='text-base text-zinc-200 mb-2'>{project.title}</h3>
                  <p class='text-sm text-zinc-400 mb-3'>
                    {project.description}
                  </p>
                  <div class='flex flex-wrap gap-1.5 mb-3'>
                    {project.technologies.map((tech) => (
                      <span class='px-1.5 py-0.5 text-xs text-zinc-400 bg-zinc-700/50 rounded'>
                        {tech}
                      </span>
                    ))}
                  </div>
                  {project.liveUrl ? (
                    <a
                      href={project.liveUrl}
                      target='_blank'
                      rel='noopener noreferrer'
                      class='inline-flex items-center gap-1 text-sm text-zinc-400 hover:text-zinc-100 transition-colors'
                    >
                      <span>View live</span>
                      <svg
                        xmlns='http://www.w3.org/2000/svg'
                        class='w-4 h-4'
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='2'
                        aria-hidden='true'
                      >
                        <path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6' />
                        <polyline points='15 3 21 3 21 9' />
                        <line x1='10' y1='14' x2='21' y2='3' />
                      </svg>
                    </a>
                  ) : (
                    <span class='inline-block text-xs text-zinc-600'>
                      Confidential source
                    </span>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div
      class='mt-16 p-6 rounded-2xl border border-zinc-800 bg-zinc-900/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4'
    >
      <div>
        <h2 class='text-lg text-zinc-200'>Looking for the code?</h2>
        <p class='text-sm text-zinc-400 mt-1 max-w-lg'>
          Personal and open source projects are on the other page, with a
          timeline of what I built and when.
        </p>
      </div>
      <Link href='/projects' variant='secondary'>See personal projects</Link>
    </div>
  </div>
</InfoLayout>
